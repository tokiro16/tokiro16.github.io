---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { url } from '../lib/urls';
---

<BaseLayout
  title="关于"
  description={`关于 ${SITE.author}：一个对游戏、物理、计算机和穿搭都好奇的人。`}
>
  <section class="about-hero container">
    <div>
      <p class="eyebrow">About / 关于</p>
      <h1 class="about-title">你好，<br />我是<em>{SITE.author}</em>。</h1>
      <p class="about-lede">
        一个好奇心有点过量的人。白天和计算机打交道，晚上在游戏里迷路；会为一条物理新闻兴奋，也会认真研究今天穿什么。这个博客是我的草稿本，也是我练习把话说清楚的地方。
      </p>
    </div>

    <div class="about-portrait" aria-hidden="true">
      <div class="portrait-caption">
        <span>
          <strong>{SITE.author}</strong>
          {SITE.location}
        </span>
        <span>PORTRAIT<br />{SITE.since} — NOW</span>
      </div>
    </div>
  </section>

  <div class="container about-body">
    <aside class="about-aside">
      Profile / 简介
      <span>玩家<br />好奇的人<br />偶尔写字</span>
    </aside>

    <div class="about-prose">
      <h2>我在做什么</h2>
      <p>
        大部分时间和计算机打交道，剩下的时间分给游戏、物理和一堆看起来没什么用的问题。会为了搞懂一个现象去翻论文，也会为了配一件外套在镜子前站二十分钟。
      </p>
      <p>
        「{SITE.title}」是我的笔名。这个博客没有明确的垂直领域，想到什么写什么：可能是一篇游戏通关后的碎碎念，也可能是一个物理问题的推导，或者只是今天买到的一支口红。
      </p>

      <h2>这里会写什么</h2>
      <p>目前有 {SITE.topics.length} 个栏目：</p>
      <ul>
        {SITE.topics.map((topic) => (
          <li><span><strong>{topic.name}</strong>：{topic.description}</span></li>
        ))}
      </ul>
      <p>
        更新频率随缘。比起追热点，我更想写那些过一阵子再读，仍然觉得有意思的东西。
      </p>

      <h2>现在</h2>
      <dl class="now-list">
        <div class="now-item">
          <dt>Reading</dt>
          <dd>《游戏设计梦工厂》</dd>
        </div>
        <div class="now-item">
          <dt>Playing</dt>
          <dd>一款还没通关的开放世界游戏</dd>
        </div>
        <div class="now-item">
          <dt>Learning</dt>
          <dd>把物理解释写得像人话</dd>
        </div>
        <div class="now-item">
          <dt>Location</dt>
          <dd>{SITE.location}</dd>
        </div>
      </dl>

      <div class="about-contact">
        <p>如果你想聊聊游戏、物理、键盘，或者今天穿什么，欢迎来 GitHub 找我。</p>
        <div class="socials">
          {SITE.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer">
              {social.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href={url('/rss.xml')}>
            RSS <Icon name="rss" size={12} />
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
