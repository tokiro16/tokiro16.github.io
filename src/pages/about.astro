---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { url } from '../lib/urls';
---

<BaseLayout
  title="关于"
  description={`关于 ${SITE.author}：写游戏、物理、计算机和穿搭。`}
>
  <section class="about-hero container">
    <div>
      <p class="eyebrow">About / 关于</p>
      <h1 class="about-title">你好，<br />我是<em>{SITE.author}</em>。</h1>
      <p class="about-lede">
        白天对着电脑，晚上打游戏。看到有意思的物理问题会去查，出门前也会为穿哪件外套纠结一会儿。这个博客放一些没地方放的想法，也顺便练练怎么把话说清楚。
      </p>
    </div>

    <figure class="about-portrait about-portrait--photo">
      <img
        src={url('/images/shiliu-sweet.jpg')}
        alt="时六的生活照"
        width="900"
        height="1200"
        loading="eager"
      />
      <span class="portrait-sticker" aria-hidden="true">SWEET</span>
      <figcaption class="portrait-caption">
        <span>
          <strong>{SITE.author}</strong>
          {SITE.location}
        </span>
        <span>PORTRAIT<br />{SITE.since} — NOW</span>
      </figcaption>
    </figure>
  </section>

  <div class="container about-body">
    <aside class="about-aside">
      Profile / 简介
      <span>玩家<br />好奇的人<br />偶尔写字</span>
    </aside>

    <div class="about-prose">
      <h2>我在做什么</h2>
      <p>
        大部分时间对着电脑，剩下的时间分给游戏、物理和一堆看起来没什么用的问题。有时候为了搞懂一个现象去翻论文，也会为了配一件外套在镜子前站二十分钟。
      </p>
      <p>
        「{SITE.title}」是我的笔名。这里没有固定主题。游戏打通了，物理看懂了，或者买到一支合适的口红，都可能顺手写两句。
      </p>

      <h2>这里写什么</h2>
      <p>目前分 {SITE.topics.length} 类：</p>
      <ul>
        {SITE.topics.map((topic) => (
          <li><span><strong>{topic.name}</strong>：{topic.description}</span></li>
        ))}
      </ul>
      <p>
        更新不定时，也不追热点。我更想写隔一阵子再看还有意思的东西。
      </p>

      <h2>现在</h2>
      <dl class="now-list">
        <div class="now-item">
          <dt>Reading</dt>
          <dd>《游戏设计梦工厂》</dd>
        </div>
        <div class="now-item">
          <dt>Playing</dt>
          <dd>还在打一款开放世界游戏，没通关</dd>
        </div>
        <div class="now-item">
          <dt>Learning</dt>
          <dd>把物理解释写得像人话</dd>
        </div>
        <div class="now-item">
          <dt>Location</dt>
          <dd>{SITE.location}</dd>
        </div>
      </dl>

      <div class="about-contact">
        <p>想聊游戏、物理、键盘，或者今天穿什么，都可以来 GitHub 找我。</p>
        <div class="socials">
          {SITE.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer">
              {social.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
          <a href={url('/rss.xml')}>
            RSS <Icon name="rss" size={12} />
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
