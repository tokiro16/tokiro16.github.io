---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ticker from '../components/Ticker.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { getAllPosts, getFeaturedPost, getRecentPosts } from '../lib/posts';
import { url } from '../lib/urls';

const featured = getFeaturedPost();
const recent = getRecentPosts(5, featured.slug);
const allPosts = getAllPosts();
---

<BaseLayout description={SITE.description}>
  <Ticker />

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A PERSONAL BLOG · EST. {SITE.since}</p>

        <h1 class="hero-title">
          <span class="line">玩游戏，</span>
          <span class="line">想问题，</span>
          <span class="line"><em>写点东西。</em></span>
        </h1>

        <p class="hero-lede">
          这里写玩乐、游戏、物理、八卦、计算机，也写美妆穿搭。想到什么写什么，没什么固定主题。
        </p>

        <dl class="hero-meta">
          <div class="hero-meta-item">
            <dt>Based in</dt>
            <dd>{SITE.location}</dd>
          </div>
          <div class="hero-meta-item">
            <dt>Writing since</dt>
            <dd>{SITE.since} — Now</dd>
          </div>
          <div class="hero-meta-item">
            <dt>Currently</dt>
            <dd>{allPosts.length} 篇日志 · {SITE.topics.length} 个栏目</dd>
          </div>
        </dl>
      </div>

      <aside class="hero-side" aria-label="照片与站点标识">
        <div class="hero-photo">
          <span class="hero-photo-tape" aria-hidden="true"></span>
          <img
            src={url('/images/shiliu-cool.jpg')}
            alt="时六的照片"
            width="900"
            height="1200"
            loading="eager"
          />
          <span class="hero-photo-label">SWEET &amp; COOL</span>
        </div>
        <p class="hero-aside-note">什么都写一点，随便看看。</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-heading">
          <span class="eyebrow eyebrow--accent">Featured / 精选</span>
          <h2 class="section-title">先看这篇</h2>
        </div>
        <a class="section-link" href={url('/blog/')}>全部文章 <Icon name="arrow-up-right" size={12} /></a>
      </div>

      <FeaturedPost post={featured} />
    </div>
  </section>

  {recent.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <div class="section-head" data-reveal>
          <div class="section-heading">
            <span class="eyebrow">Latest / 最新</span>
            <h2 class="section-title">最近写的</h2>
          </div>
          <a class="section-link" href={url('/blog/')}>查看全部 <Icon name="arrow-up-right" size={12} /></a>
        </div>

        <div class="post-list">
          {recent.map((post, index) => <PostRow post={post} index={index + 2} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section section--tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-heading">
          <span class="eyebrow">Topics / 主题</span>
          <h2 class="section-title">写些什么</h2>
        </div>
        <a class="section-link" href={url('/tags/')}>按标签看 <Icon name="arrow-up-right" size={12} /></a>
      </div>

      <div class="topics-grid" data-reveal>
        {
          SITE.topics.map((topic) => (
            <a class="topic-card" href={url(`/blog/?category=${encodeURIComponent(topic.name)}`)}>
              <span class="topic-index">{topic.count}</span>
              <span>
                <span class="topic-name">{topic.name}</span>
                <span class="topic-desc">{topic.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-band" data-reveal>
        <div>
          <p class="eyebrow">About / 关于</p>
          <h2 class="about-band-title">写下来，<br /><em>免得忘了。</em></h2>
        </div>
        <div class="about-band-copy">
          <p>
            白天和计算机打交道，晚上打游戏。偶尔会为了一个物理问题查半天资料。这里写的东西很杂，都是我自己想记的。
          </p>
          <a class="text-link" href={url('/about/')}>
            认识一下 <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
