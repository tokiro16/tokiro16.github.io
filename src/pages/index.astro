---
import BaseLayout from '../layouts/BaseLayout.astro';
import Ticker from '../components/Ticker.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostRow from '../components/PostRow.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
import { getAllPosts, getFeaturedPost, getRecentPosts } from '../lib/posts';
import { url } from '../lib/urls';

const featured = getFeaturedPost();
const recent = getRecentPosts(5, featured.slug);
const allPosts = getAllPosts();
const categories = [...new Set(allPosts.map((post) => post.category))];
---

<BaseLayout description={SITE.description}>
  <Ticker />

  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A PERSONAL BLOG · EST. {SITE.since}</p>

        <h1 class="hero-title">
          <span class="line">在游戏与</span>
          <span class="line">公式之间，</span>
          <span class="line"><em>随手记点。</em></span>
        </h1>

        <p class="hero-lede">
          这里记录玩乐、游戏、物理、八卦、计算机，还有美妆穿搭。没有垂直领域，只有持续好奇。
        </p>

        <dl class="hero-meta">
          <div class="hero-meta-item">
            <dt>Based in</dt>
            <dd>{SITE.location}</dd>
          </div>
          <div class="hero-meta-item">
            <dt>Writing since</dt>
            <dd>{SITE.since} — Now</dd>
          </div>
          <div class="hero-meta-item">
            <dt>Currently</dt>
            <dd>{allPosts.length} 篇文章 · {categories.length} 个栏目</dd>
          </div>
        </dl>
      </div>

      <aside class="hero-side" aria-label="站点标识">
        <div class="hero-seal" aria-hidden="true">
          <div class="hero-seal-inner">
            <span class="hero-seal-cn">{SITE.name}</span>
            <span class="hero-seal-en">{SITE.latin} / NOTES</span>
            <span class="hero-seal-year">MMXXVI</span>
          </div>
        </div>
        <p class="hero-aside-note">一个什么都想写一点的角落，欢迎随便看看。</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-heading">
          <span class="eyebrow eyebrow--accent">Featured / 精选</span>
          <h2 class="section-title">本期推荐</h2>
        </div>
        <a class="section-link" href={url('/blog/')}>全部文章 <Icon name="arrow-up-right" size={12} /></a>
      </div>

      <FeaturedPost post={featured} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-heading">
          <span class="eyebrow">Latest / 最新</span>
          <h2 class="section-title">最近写下的</h2>
        </div>
        <a class="section-link" href={url('/blog/')}>查看全部 <Icon name="arrow-up-right" size={12} /></a>
      </div>

      <div class="post-list">
        {recent.map((post, index) => <PostRow post={post} index={index + 2} />)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="section-heading">
          <span class="eyebrow">Topics / 主题</span>
          <h2 class="section-title">在琢磨什么</h2>
        </div>
        <a class="section-link" href={url('/tags/')}>按标签浏览 <Icon name="arrow-up-right" size={12} /></a>
      </div>

      <div class="topics-grid" data-reveal>
        {
          SITE.topics.map((topic) => (
            <a class="topic-card" href={url(`/blog/?category=${encodeURIComponent(topic.name)}`)}>
              <span class="topic-index">{topic.count}</span>
              <span>
                <span class="topic-name">{topic.name}</span>
                <span class="topic-desc">{topic.description}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-band" data-reveal>
        <div>
          <p class="eyebrow">About / 关于</p>
          <h2 class="about-band-title">好奇心是<br /><em>最好的借口。</em></h2>
        </div>
        <div class="about-band-copy">
          <p>
            白天和计算机打交道，晚上在游戏里迷路，偶尔用物理解释生活。这个博客没有算法推荐，只有一些认真玩过、想过的东西。
          </p>
          <a class="text-link" href={url('/about/')}>
            认识一下 <Icon name="arrow-right" size={13} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
