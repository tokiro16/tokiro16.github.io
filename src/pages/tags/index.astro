---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/posts';
import { url } from '../../lib/urls';

const tags = getAllTags();
---

<BaseLayout
  title="标签"
  description="按时六博客的标签找文章。"
>
  <header class="page-header container">
    <div>
      <p class="eyebrow">Tags / 标签</p>
      <h1 class="page-title">按<em>标签</em>看。</h1>
    </div>
    <p class="page-intro">
      共 <strong>{tags.length} 个标签</strong>。点一个，看看写了些什么。
    </p>
  </header>

  <div class="container">
    <div class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <a href={url(`/tags/${tag}/`)}>
          {tag}
          <span class="count">{String(count).padStart(2, '0')}</span>
        </a>
      ))}
    </div>

    <div style="height: clamp(3rem, 6vw, 6rem);"></div>
  </div>
</BaseLayout>
