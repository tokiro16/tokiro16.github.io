---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/posts';
import { url } from '../../lib/urls';

const tags = getAllTags();
const total = tags.reduce((sum, item) => sum + item.count, 0);
---

<BaseLayout
  title="标签"
  description="按标签浏览时六博客的所有文章：玩乐、游戏、物理、八卦、计算机与美妆穿搭。"
>
  <header class="page-header container">
    <div>
      <p class="eyebrow">Tags / 标签</p>
      <h1 class="page-title">按<em>标签</em>读。</h1>
    </div>
    <p class="page-intro">
      共 <strong>{tags.length} 个标签</strong>，{total} 次归类。它们像抽屉上的小纸条，帮你找到相似的东西。
    </p>
  </header>

  <div class="container">
    <div class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <a href={url(`/tags/${tag}/`)}>
          {tag}
          <span class="count">{String(count).padStart(2, '0')}</span>
        </a>
      ))}
    </div>

    <div style="height: clamp(3rem, 6vw, 6rem);"></div>
  </div>
</BaseLayout>
