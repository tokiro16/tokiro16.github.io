---
import { SITE, NAV } from '../config';
import { url } from '../lib/urls';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return path === '/';
  return path === target || path.startsWith(`${target}/`);
}
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={url('/')} aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">{SITE.name.slice(0, 1)}</span>
      <span class="brand-text">
        <span class="brand-name">{SITE.name}</span>
        <span class="brand-sub">{SITE.latin} / NOTES</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-search-open aria-label="打开搜索">
        <span>搜索</span>
        <kbd>⌘K</kbd>
      </button>

      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色模式">
        <Icon name="moon" class="icon-moon" size={17} />
        <Icon name="sun" class="icon-sun" size={17} />
      </button>

      <button
        class="icon-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="打开菜单"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="icon-menu" size={19} />
        <Icon name="close" class="icon-close" size={19} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="container mobile-menu-inner">
      {
        NAV.map((item, index) => (
          <a href={url(item.href)}>
            {item.label}
            <span>0{index + 1}</span>
          </a>
        ))
      }
      <a href="#search" class="mobile-search" data-search-open>搜索文章 →</a>
    </div>
  </div>
</header>
