---
import { url } from '../lib/urls';

interface Props {
  name: string;
  alt: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { name, alt, loading = 'lazy', class: className } = Astro.props;
const file = /\.[a-z0-9]+$/i.test(name) ? name : `${name}.svg`;
const src = url(`/covers/${file}`);
---

<img
  class={className}
  src={src}
  alt={alt}
  width="1200"
  height="900"
  loading={loading}
  decoding="async"
/>
