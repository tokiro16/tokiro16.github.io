---
import type { Post } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  index?: number;
}

const { post, index = 1 } = Astro.props;
const date = new Date(post.date);
const day = String(date.getUTCDate()).padStart(2, '0');
const monthYear = `${date.getUTCFullYear()}.${String(date.getUTCMonth() + 1).padStart(2, '0')}`;
---

<a class="post-row" href={post.href} data-reveal>
  <span class="post-row-date">
    <strong>{day}</strong>
    <span>{monthYear}</span>
  </span>

  <h3 class="post-row-title">
    <span class="index-number" aria-hidden="true">{String(index).padStart(2, '0')} / </span>
    {post.title}
  </h3>

  <span class="post-row-tags" aria-label="标签">
    {post.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
  </span>

  <span class="post-row-arrow" aria-hidden="true">
    <Icon name="arrow-up-right" size={12} />
  </span>
</a>
