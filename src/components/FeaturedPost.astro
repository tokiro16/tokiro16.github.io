---
import type { Post } from '../lib/posts';
import { SITE } from '../config';
import Icon from './Icon.astro';
import PostCover from './PostCover.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="featured-card" data-reveal>
  <a class="featured-media" href={post.href} aria-label={`阅读《${post.title}》`}>
    <PostCover name={post.cover} alt={post.title} loading="eager" />
    <span class="media-index">01</span>
  </a>

  <div class="featured-content">
    <div class="post-kicker">
      <span class="category">{post.category}</span>
      <span class="dot" aria-hidden="true"></span>
      <span>{post.readingTime} 分钟阅读</span>
      <span class="dot" aria-hidden="true"></span>
      <span>{SITE.latin} / FEATURED</span>
    </div>

    <h2 class="featured-title">
      <a href={post.href}>{post.title}</a>
    </h2>

    <p class="featured-excerpt">{post.description}</p>

    <a class="text-link" href={post.href}>
      阅读全文
      <Icon name="arrow-right" size={13} />
    </a>
  </div>
</article>
