---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import StickerLayer from '../components/StickerLayer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  progress?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  progress = false,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
    />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body id="top" data-base={base}>
    <StickerLayer />
    <a class="skip-link" href="#main">跳到正文</a>
    {progress && <div class="reading-progress" data-reading-progress aria-hidden="true"></div>}

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <SearchDialog />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
